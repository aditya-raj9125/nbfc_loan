# ------ Node / Next.js ------
node_modules/
.pnp/
.pnp.js
.next/
out/
build/
dist/

# ------ Python backend ------
backend/venv/
__pycache__/
*.py[cod]
*.pyo
*.pyd
*.egg-info/
*.egg
.Python
pip-log.txt
pip-delete-this-directory.txt
.pytest_cache/
.mypy_cache/
.ruff_cache/

# ------ Uploaded / generated files ------
backend/uploads/
diagrams/

# ------ Environment & secrets ------
.env
.env.local
.env.development.local
.env.test.local
.env.production.local
backend/.env

# Google / Firebase service account keys
*.json
# Allow package.json, tsconfig.json, etc. (re-include explicit config files)
!package.json
!package-lock.json
!tsconfig.json
!next.config.js
!postcss.config.js
!tailwind.config.js
!.vscode/settings.json

# ------ Logs ------
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

