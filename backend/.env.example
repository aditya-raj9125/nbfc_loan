# ===========================================
# NBFC Loan Chatbot - Groq Configuration
# ===========================================
# Copy this file to .env and fill in your values

# Google Gemini LLM (Primary Provider - Recommended: Free at https://aistudio.google.com/)
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
GEMINI_VISION_MODEL=gemini-2.5-flash

# Groq LLM (Alternative Provider)
GROQ_API_KEY=your_groq_api_key_here
GROQ_MODEL=llama-3.3-70b-versatile
GROQ_VISION_MODEL=llama-3.2-11b-vision-preview

# Database
DATABASE_URL=postgresql://postgres:password@localhost:5432/nbfc_loan_db

# Redis
REDIS_URL=redis://localhost:6379/0

# CORS
FRONTEND_URL=http://localhost:3000

# Security
SECRET_KEY=your-secret-key-change-this-in-production

# File Upload
UPLOAD_DIR=./uploads
MAX_FILE_SIZE=10485760

# Mock API Settings
MOCK_CRM_ENABLED=true
MOCK_CREDIT_BUREAU_ENABLED=true
